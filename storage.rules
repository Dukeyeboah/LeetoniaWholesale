rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isAuthenticated() && firestore.exists(userPath());
    }

    function userData() {
      return firestore.get(userPath()).data;
    }

    function userRole() {
      return userData().role;
    }

    // Matches Firestore `isPrivilegedAdmin` (admin + super_admin)
    function isPrivilegedAdmin() {
      return userExists() &&
        (userRole() == 'admin' || userRole() == 'super_admin');
    }

    function staffCanManageInventory() {
      return userExists() &&
        userRole() == 'staff' &&
        'permissions' in userData() &&
        userData().permissions.canManageInventory == true;
    }

    function canManageInventoryImages() {
      return isPrivilegedAdmin() || staffCanManageInventory();
    }

    function isImageUpload() {
      return request.resource != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Product images (legacy path)
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if canManageInventoryImages() && isImageUpload();
    }

    // Inventory images (admin uploads: inventoryImages/products/...)
    match /inventoryImages/{allPaths=**} {
      allow read: if true;
      allow write: if canManageInventoryImages() && isImageUpload();
    }

    // User avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        isPrivilegedAdmin()
      ) && isImageUpload();
    }

    // Order documents (invoices, receipts, etc.)
    match /orders/{orderId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
        isPrivilegedAdmin()
      );
      allow write: if isPrivilegedAdmin();
    }
  }
}
