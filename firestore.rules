rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return getUserData().role;
    }

    // Admin or super_admin (dashboard, inventory, orders)
    function isPrivilegedAdmin() {
      return isAuthenticated() && (userRole() == 'admin' || userRole() == 'super_admin');
    }

    function isSuperAdmin() {
      return isAuthenticated() && userRole() == 'super_admin';
    }

    function isClient() {
      return isAuthenticated() && userRole() == 'client';
    }

    function isStaff() {
      return isAuthenticated() && userRole() == 'staff';
    }

    function getStaffPermissions() {
      return getUserData().permissions;
    }

    function staffHasPermission(permission) {
      return isPrivilegedAdmin() || (isStaff() && getStaffPermissions() != null && getStaffPermissions()[permission] == true);
    }
    function isKnownSeedPharmacy(id) {
      return id in ['amanfrom', 'avalon', 'caads', 'carehub', 'dayben', 'diagnopharma', 'dixxons', 'empat', 'grit', 'interpharma'];
    }

    // Self-serve profile: cannot change role/permissions; signInProvider only on first set (backfill).
    function userSelfProfileUpdateAllowed(userId) {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == userId &&
        !diffKeys.hasAny(['role', 'permissions']) &&
        (
          !diffKeys.hasAny(['signInProvider']) ||
          (
            resource.data.get('signInProvider', '') == '' &&
            request.resource.data.get('signInProvider', '') != ''
          )
        );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        userSelfProfileUpdateAllowed(userId) ||
        isPrivilegedAdmin()
      );
      allow delete: if isPrivilegedAdmin();
    }

    match /inventory/{productId} {
      allow read: if true;
      allow create, delete: if isPrivilegedAdmin() || staffHasPermission('canManageInventory');
      // Stock counts: admins/staff; clients may only touch reservedQty (checkout / finalize).
      allow update: if isPrivilegedAdmin() || staffHasPermission('canManageInventory') ||
        (isClient() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedQty', 'updatedAt']));
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isPrivilegedAdmin() ||
        staffHasPermission('canViewOrders')
      );
      allow create: if isAuthenticated() &&
        (isClient() || isPrivilegedAdmin()) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isPrivilegedAdmin() ||
        // Client finalizes proforma (may edit items/total) and sets status to client_finalized.
        (resource.data.userId == request.auth.uid &&
         resource.data.status == 'proforma_sent' &&
         request.resource.data.status == 'client_finalized' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'userId', 'createdAt', 'userName', 'userEmail', 'pharmacyId',
           'pharmacyName', 'displayOrderId', 'submittedItems', 'submittedTotal',
           'accountingStatus', 'paymentReceivedAt', 'amountPaidGHS', 'stockReserved',
           'proformaSentAt', 'proformaNote', 'invoiceSentAt'
         ])) ||
        // Legacy orders: customer adds delivery/payment only (admin advanced status separately).
        (resource.data.userId == request.auth.uid &&
         resource.data.status == 'pharmacy_confirmed' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'status', 'userId', 'items', 'total', 'createdAt', 'userName', 'userEmail'
         ]))
      );
      allow delete: if isPrivilegedAdmin();
    }

    match /logs/{logId} {
      allow read: if isPrivilegedAdmin();
      allow create: if isPrivilegedAdmin();
      allow update, delete: if isPrivilegedAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
    }

    match /pharmacies/{pharmacyId} {
      allow read: if isAuthenticated();

      // Super admin creates any id; clients create signup rows or first-touch seeds.
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (isClient() && (
          isKnownSeedPharmacy(pharmacyId) ||
          pharmacyId.matches('^pharm_added_.+')
        ))
      );

      // Client checkout: may bump month spend only (monthly limit + name unchanged; no billing/credit edits).
      function pharmacyClientSpendUpdate() {
        return isClient() &&
          request.resource.data.monthlyLimitGHS == resource.data.monthlyLimitGHS &&
          request.resource.data.name == resource.data.name &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'customerBillingType', 'allowsAccountCredit', 'creditLimitGHS', 'creditBalanceGHS',
            'pendingVerification', 'verifiedAt', 'source', 'location', 'phone', 'contactPerson',
            'createdByUserId'
          ]);
      }

      allow update: if isPrivilegedAdmin() ||
        pharmacyClientSpendUpdate();

      allow delete: if isSuperAdmin();
    }

    match /returns/{returnId} {
      allow read, create, update, delete: if isPrivilegedAdmin();
    }

    // Super-admin HR: loans, leave, payroll deductions (not client-facing).
    match /staffMembers/{staffId} {
      allow read, create, update, delete: if isSuperAdmin();
    }
  }
}
