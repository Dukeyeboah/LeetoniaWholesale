rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return getUserData().role;
    }

    // Admin or super_admin (dashboard, inventory, orders)
    function isPrivilegedAdmin() {
      return isAuthenticated() && (userRole() == 'admin' || userRole() == 'super_admin');
    }

    function isSuperAdmin() {
      return isAuthenticated() && userRole() == 'super_admin';
    }

    function isClient() {
      return isAuthenticated() && userRole() == 'client';
    }

    function isStaff() {
      return isAuthenticated() && userRole() == 'staff';
    }

    function getStaffPermissions() {
      return getUserData().permissions;
    }

    function staffHasPermission(permission) {
      return isPrivilegedAdmin() || (isStaff() && getStaffPermissions() != null && getStaffPermissions()[permission] == true);
    }

    function isKnownSeedPharmacy(id) {
      return id in ['amanfrom', 'avalon', 'caads', 'carehub', 'dayben', 'diagnopharma', 'dixxons', 'empat', 'grit', 'interpharma'];
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])) ||
        isPrivilegedAdmin()
      );
      allow delete: if isPrivilegedAdmin();
    }

    match /inventory/{productId} {
      allow read: if true;
      allow create, update, delete: if isPrivilegedAdmin() || staffHasPermission('canManageInventory');
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isPrivilegedAdmin() ||
        staffHasPermission('canViewOrders')
      );
      allow create: if isAuthenticated() &&
        (isClient() || isPrivilegedAdmin()) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isPrivilegedAdmin() ||
        // Client finalizes proforma (may edit items/total) and sets status to client_finalized.
        (resource.data.userId == request.auth.uid &&
         resource.data.status == 'proforma_sent' &&
         request.resource.data.status == 'client_finalized' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'userId', 'createdAt', 'userName', 'userEmail', 'pharmacyId',
           'pharmacyName', 'displayOrderId', 'submittedItems', 'submittedTotal',
           'accountingStatus', 'paymentReceivedAt', 'proformaSentAt', 'proformaNote', 'invoiceSentAt'
         ])) ||
        // Legacy orders: customer adds delivery/payment only (admin advanced status separately).
        (resource.data.userId == request.auth.uid &&
         resource.data.status == 'pharmacy_confirmed' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'status', 'userId', 'items', 'total', 'createdAt', 'userName', 'userEmail'
         ]))
      );
      allow delete: if isPrivilegedAdmin();
    }

    match /logs/{logId} {
      allow read: if isPrivilegedAdmin();
      allow create: if isPrivilegedAdmin();
      allow update, delete: if isPrivilegedAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
    }

    match /pharmacies/{pharmacyId} {
      allow read: if isAuthenticated();

      // Client creates: known seeds or signup-added ids (pharm_added_*).
      allow create: if isAuthenticated() && (
        isPrivilegedAdmin() ||
        (isClient() && (
          isKnownSeedPharmacy(pharmacyId) ||
          pharmacyId.matches('^pharm_added_.+')
        ))
      );

      allow update: if isSuperAdmin() || (
        isClient() &&
        request.resource.data.monthlyLimitGHS == resource.data.monthlyLimitGHS &&
        request.resource.data.name == resource.data.name
      );
    }
  }
}
